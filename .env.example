# Variables de entorno reconocidas. Defínelas en tu shell o en la configuración de tu IDE.

# Por defecto se usa SQLite en data/eps_demo.db. Para SQL Server con autenticación de Windows:
# EPS_DB_URL=mssql+pyodbc://@localhost/ProyectoEPS?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# Con usuario y contraseña:
# EPS_DB_URL=mssql+pyodbc://usuario:clave@servidor:1433/ProyectoEPS?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Carpeta donde se escriben el Excel y los gráficos (por defecto ./output)
# EPS_OUTPUT_DIR=output
